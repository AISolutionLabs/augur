{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "Augur",
  "id": "augur-assistant-app",
  "info": {
    "keywords": [
      "claude",
      "ai",
      "assistant",
      "investigation",
      "loki",
      "tempo",
      "mimir",
      "prometheus"
    ],
    "description": "Chat with Claude about your metrics, logs and traces, run deep investigations across the LGTM stack, and build dashboards. Read-only queries run as the signed-in user.",
    "author": {
      "name": "AniAIApps",
      "url": "https://github.com/AniAIApps"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "screenshots": [],
    "version": "%VERSION%",
    "updated": "%TODAY%",
    "links": [
      {
        "name": "Source",
        "url": "https://github.com/AniAIApps/augur"
      },
      {
        "name": "License",
        "url": "https://github.com/AniAIApps/augur/blob/main/LICENSE"
      }
    ]
  },
  "includes": [
    {
      "type": "page",
      "name": "Augur",
      "path": "/a/%PLUGIN_ID%",
      "addToNav": true,
      "defaultNav": true,
      "icon": "comment-alt"
    },
    {
      "type": "datasource",
      "name": "Claude (Augur)",
      "pluginId": "augur-claude-datasource"
    }
  ],
  "dependencies": {
    "grafanaDependency": ">=12.0.0",
    "plugins": [
      {
        "id": "augur-claude-datasource",
        "type": "datasource",
        "name": "Claude (Augur)",
        "version": "1.x"
      }
    ]
  },
  "extensions": {
    "addedLinks": [
      {
        "targets": [
          "grafana/dashboard/panel/menu"
        ],
        "title": "Ask Augur about this panel",
        "description": "Explain what this panel shows and anything unusual"
      },
      {
        "targets": [
          "grafana/dashboard/panel/menu"
        ],
        "title": "Investigate with Augur",
        "description": "Root-cause analysis across metrics, logs and traces starting from this panel"
      },
      {
        "targets": [
          "grafana/explore/toolbar/action"
        ],
        "title": "Ask Augur",
        "description": "Explain, fix or improve these queries"
      },
      {
        "targets": [
          "grafana/alerting/alertingrule/action",
          "grafana/alerting/instance/action"
        ],
        "title": "Investigate with Augur",
        "description": "Root-cause analysis for this alert"
      },
      {
        "targets": [
          "grafana/commandpalette/action"
        ],
        "title": "Ask Augur",
        "description": "Chat with Augur about your observability data"
      }
    ],
    "addedComponents": [
      {
        "targets": [
          "grafana/extension-sidebar/v0-alpha"
        ],
        "title": "Augur",
        "description": "Ask Augur about what you are looking at"
      }
    ]
  }
}
